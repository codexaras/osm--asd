{
  "name": "resourcehub-backend",
  "version": "1.0.0",
  "description": "ResourceHub - Office Resource Management System REST API (Express + MongoDB + Prometheus)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "node --check src/server.js && node scripts/check-syntax.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
