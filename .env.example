# ============================================================
#  ResourceHub - environment configuration
#  Copy to .env  (cp .env.example .env)  and adjust as needed.
#  docker compose reads this file automatically.
# ============================================================

# ---- Backend API ----
NODE_ENV=production
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Load demo users/resources/bookings on first start (empty database only)
SEED_ON_START=true

# MongoDB (the compose stack runs its own MongoDB container)
MONGO_URI=mongodb://mongo:27017/resourcehub

# ---- Published host ports ----
FRONTEND_PORT=8080
BACKEND_PORT=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Jira (used by scripts/jira/*.py locally; in GitHub these are repository secrets) ----
JIRA_BASE_URL=https://aravpalod2.atlassian.net
JIRA_USER_EMAIL=you@example.com
JIRA_API_TOKEN=paste_api_token_here
JIRA_PROJECT_KEY=ORMS
